generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── SongCraft Models ─────────────────────────────────────────────────────────

model TgUser {
  id            Int            @id @default(autoincrement())
  telegramId    String         @unique
  username      String?
  firstName     String
  lastName      String?
  languageCode  String         @default("ru")
  balance       Int            @default(0)
  totalSpent    Int            @default(0)
  freeCredits   Int            @default(3) // trial: 2 free tracks
  referralCode  String         @unique @default(cuid())
  referredById  Int?
  referredBy    TgUser?        @relation("Referrals", fields: [referredById], references: [id])
  referrals     TgUser[]       @relation("Referrals")
  orders        Order[]
  transactions  Transaction[]
  voiceProfiles VoiceProfile[]
  mediaAssets   MediaAsset[]
  songDrafts    SongDraft[]
  songActions   SongAction[]
  marketingEvents MarketingEvent[]
  acquisitionSource String?
  acquisitionMedium String?
  acquisitionCampaign String?
  acquisitionContent String?
  acquisitionTerm String?
  acquisitionStartParam String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// status: PENDING | PAID | PROCESSING | ENHANCING | GENERATING | COMPLETED | FAILED | REFUNDING | REFUNDED
// plan:   BASIC | STANDARD | PREMIUM
model Order {
  id     Int    @id @default(autoincrement())
  userId Int
  user   TgUser @relation(fields: [userId], references: [id])
  status String @default("PENDING")
  plan   String
  progress        Int     @default(0)
  progressStage   String?
  progressMessage String?
  selectedSongId  Int?

  recipientName          String
  recipientPronunciation String?
  trackTitle             String?
  occasion               String
  userText               String
  enhancedLyrics         String?
  approvedLyrics         String?
  lyricsApprovedAt       DateTime?
  draftId                String?
  genre                  String
  mood                   String
  voiceType              String? // female | male
  voiceProfileId         Int?
  voiceProfile           VoiceProfile? @relation(fields: [voiceProfileId], references: [id])
  style                  String?
  tempo                  String        @default("medium")
  language               String        @default("ru")
  generationModel        String?
  generationSettings     String?

  addCover       Boolean @default(false)
  addVideo       Boolean @default(false)
  videoStyle     String?
  videoPhotoTokens String?
  giftPhotoToken String?
  addSpokenIntro Boolean @default(false)
  spokenIntroToken String?
  coverUrl       String?
  videoUrl       String?

  songs Song[]

  amount        Int
  paymentId     String?
  paymentSource String? // balance | telegram_stars
  paidAt        DateTime?

  sunoJobId    String?
  errorMessage String?
  retryCount   Int     @default(0)
  hiddenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Song {
  id         Int     @id @default(autoincrement())
  shareToken String? @unique @default(cuid())
  orderId    Int
  order      Order   @relation(fields: [orderId], references: [id])

  sunoId           String
  sunoTaskId       String?
  title            String
  audioUrl         String
  imageUrl         String?
  providerAudioUrl String?
  providerImageUrl String?
  wavUrl           String?
  vocalUrl         String?
  instrumentalUrl  String?
  duration         Int?
  fileId           String?
  model            String?
  stylePrompt      String?
  negativeTags     String?
  lyricsJson       String?
  waveformJson     String?
  qualityScore     Float?
  variantIndex     Int          @default(0)
  candidateIndex   Int          @default(0)
  isSelected       Boolean      @default(true)
  metadata         String?
  actions          SongAction[]

  createdAt DateTime @default(now())
}

model SongDraft {
  id                String   @id @default(cuid())
  userId            Int
  user              TgUser   @relation(fields: [userId], references: [id])
  mode              String   @default("gift")
  briefJson         String
  lyrics            String
  title             String
  stylePrompt       String
  negativeTags      String?
  pronunciationJson String?
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

model VoiceProfile {
  id                     Int      @id @default(autoincrement())
  userId                 Int
  user                   TgUser   @relation(fields: [userId], references: [id])
  name                   String
  status                 String   @default("UPLOADED")
  sourceMediaToken       String?
  verificationMediaToken String?
  validationTaskId       String?
  validationPhrase       String?
  voiceTaskId            String?
  voiceId                String?  @unique
  language               String   @default("ru")
  style                  String?
  singerSkillLevel       String   @default("intermediate")
  consentAt              DateTime
  errorMessage           String?
  orders                 Order[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId, status])
}

model SongAction {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           TgUser   @relation(fields: [userId], references: [id])
  songId         Int
  song           Song     @relation(fields: [songId], references: [id])
  type           String
  status         String   @default("PENDING")
  inputJson      String
  providerTaskId String?
  resultJson     String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([songId, type])
}

model MarketingEvent {
  id         String   @id @default(cuid())
  userId     Int?
  user       TgUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  event      String
  path       String?
  source     String?
  medium     String?
  campaign   String?
  content    String?
  term       String?
  startParam String?
  referrer   String?
  shareToken String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([source, campaign])
}

model SunoTask {
  id             Int      @id @default(autoincrement())
  taskId         String   @unique
  kind           String
  orderId        Int?
  actionId       Int?
  voiceProfileId Int?
  variantIndex   Int?
  status         String   @default("PENDING")
  callbackType   String?
  responseJson   String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId, status])
  @@index([actionId, status])
  @@index([voiceProfileId, status])
}

model MediaAsset {
  id          Int      @id @default(autoincrement())
  token       String   @unique @default(cuid())
  userId      Int?
  user        TgUser?  @relation(fields: [userId], references: [id])
  kind        String
  storagePath String   @unique
  filename    String
  mimeType    String
  size        Int
  originalUrl String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId, kind])
}

// type: PAYMENT | REFUND | REFERRAL_BONUS | ADMIN_CREDIT
model Transaction {
  id          Int      @id @default(autoincrement())
  externalId  String?  @unique
  userId      Int
  user        TgUser   @relation(fields: [userId], references: [id])
  type        String
  amount      Int
  description String
  orderId     Int?
  metadata    String?
  createdAt   DateTime @default(now())
}

