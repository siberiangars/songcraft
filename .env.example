# Telegram
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=v3techtrackbot
MINI_APP_URL=https://your-domain.com/songcraft
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# APIs
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
TEXT_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_API_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
SUNO_API_URL=https://api.sunoapi.org/api/v1
SUNO_API_KEY=your_suno_key
SUNO_MODEL=V5_5
SUNO_FALLBACK_MODEL=V5
SUNO_STYLE_WEIGHT=0.78
SUNO_WEIRDNESS=0.34
SUNO_AUDIO_WEIGHT=0.65
SUNO_CALLBACK_SECRET=generate_a_long_random_value
# SUNO_PROVIDER: sunoapi | kie | self (default: sunoapi)
SUNO_PROVIDER=sunoapi

# Payment (Telegram Stars — no extra key needed)
# For ruble payments via YooKassa:
PAYMENT_PROVIDER_TOKEN=your_yukassa_token
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RECEIPT_EMAIL=payments@your-domain.com

# Database
DATABASE_URL=file:./dev.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/songcraft

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=development
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
PUBLIC_BASE_URL=https://your-domain.com
MEDIA_STORAGE_DIR=/app/data/songcraft-media
MAX_AUDIO_UPLOAD_MB=25
